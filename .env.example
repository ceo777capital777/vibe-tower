# AI Prompt Generator — заполните ОДИН из ключей (или оба).
# Ключи читаются только на сервере (app/api/generate/route.ts) и никогда не попадают в браузер.

# Провайдер по умолчанию: если задан OPENAI_API_KEY — OpenAI, иначе Anthropic.
# Можно указать явно: openai | anthropic
AI_PROVIDER=

OPENAI_API_KEY=
# Необязательно: модель и совместимый endpoint (например, прокси)
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Публичный адрес сайта (для canonical / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Необязательно. Серверная проверка initData Telegram Mini App.
# Токен бота от @BotFather. Никогда не коммитьте его и не используйте префикс NEXT_PUBLIC_.
# Без этой переменной сайт и Mini App работают как обычно, проверка просто пропускается.
TELEGRAM_BOT_TOKEN=
